
# .env.example — commit this file
# .env.local  — never commit, copy from this file

# ── CLERK AUTHENTICATION ─────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Dashboard → Webhooks: subscribe at least organization.created, organizationMembership.created,
# organizationMembership.updated (syncs Prisma `OrgMember.role` with Clerk).
CLERK_WEBHOOK_SECRET=whsec_...
# Clerk Dashboard → Paths (or User & authentication): allow redirects to your app after org invites,
# e.g. http://localhost:3000/post-auth and https://<production-domain>/post-auth — or patterns your
# Clerk instance supports. Missing entries cause "cannot redirect to your application" after invite.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# ── DATABASE ─────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=verify-full"

# ── ENCRYPTION ───────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be exactly 64 hex characters (32 bytes). Store in 1Password.
ENCRYPTION_KEY=

# ── AWS ──────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=cyberguardintel-evidence-prod
# Optional for local evidence uploads; if omitted, the app falls back to the
# repo-standard alias ARN for the current AWS account:
# arn:aws:kms:<region>:<account-id>:alias/cyberguardintel-evidence-prod
KMS_KEY_ID=

# ── AI SERVICE ───────────────────────────────────────────────────
# Public URL of the FastAPI app (cyberguardintel-ai), not the Next.js app.
# Sanity check: GET ${AI_SERVICE_URL}/health must return JSON like {"status":"ok","model":"..."}.
# If you see plain text "OK" or ASCII art, the hostname is Railway's placeholder or the wrong service —
# use Railway → your Python service → Networking → generate/copy the real deployment URL.
AI_SERVICE_URL=https://your-fastapi-service.up.railway.app
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_KEY=
# Vercel Cron sends Authorization: Bearer CRON_SECRET (set equal to INTERNAL_API_KEY or use a dedicated secret)
CRON_SECRET=

# ── UPSTASH REDIS (BullMQ job queue) ─────────────────────────────
# BullMQ requires the TCP URL (Upstash console → Redis → Connect → Node/ioredis).
# Required on Vercel (enqueue) and on the Railway worker service (consume).
UPSTASH_REDIS_URL=rediss://default:YOUR_TOKEN@YOUR_HOST.upstash.io:6379
# If you only have the REST hostname (https://...), you can set that as UPSTASH_REDIS_URL
# together with UPSTASH_REDIS_REST_TOKEN (or UPSTASH_REDIS_TOKEN) and the app builds the TCP URL.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── RAILWAY WORKER ───────────────────────────────────────────────
# Deploy Dockerfile.worker as a separate Railway service (see README).
# Worker needs: DATABASE_URL, ENCRYPTION_KEY, UPSTASH_REDIS_URL, AI_SERVICE_URL,
# INTERNAL_API_KEY, and AWS S3/KMS vars. Next.js stays on Vercel.

# ── EMAIL ────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
FROM_EMAIL=compliance@cyberguardintel.ai

# ── STRIPE ───────────────────────────────────────────────────────
# STRIPE_SECRET_KEY must be sk_test_... / sk_live_... (not the publishable key).
# Seed products/prices: npm run stripe:seed (prints Price IDs to paste below).
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_STARTER_MONTHLY_PRICE_ID=price_...
STRIPE_STARTER_ANNUAL_PRICE_ID=price_...
STRIPE_GROWTH_MONTHLY_PRICE_ID=price_...
STRIPE_GROWTH_ANNUAL_PRICE_ID=price_...
STRIPE_BUSINESS_MONTHLY_PRICE_ID=price_...
STRIPE_BUSINESS_ANNUAL_PRICE_ID=price_...

# ── GOOGLE WORKSPACE INTEGRATION (OAuth 2.0) ─────────────────────
GOOGLE_WORKSPACE_CLIENT_ID=
GOOGLE_WORKSPACE_CLIENT_SECRET=
GOOGLE_WORKSPACE_REDIRECT_URI=http://localhost:3000/api/integrations/google-workspace/callback
# Optional; defaults to ENCRYPTION_KEY for OAuth state HMAC signing
OAUTH_STATE_SECRET=

# ── OTHER OAUTH INTEGRATIONS ─────────────────────────────────────
# Required to connect these providers. Without them, Connect redirects
# back to /integrations with a clear "not configured" message.
MICROSOFT_365_CLIENT_ID=
MICROSOFT_365_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=

# ── APP CONFIG ───────────────────────────────────────────────────
# Must match the same origin you allow in Clerk for invite redirects (see CLERK notes above).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── SENTRY (error monitoring) ─────────────────────────────────────
# One Sentry project/DSN covers all environments — they're told apart by the
# `environment` tag (Vercel's VERCEL_ENV: "production" | "preview" |
# "development"), set automatically in sentry.server.config.ts,
# sentry.edge.config.ts, and instrumentation-client.ts. Leave blank locally;
# Sentry.init() no-ops when the DSN is empty (see `enabled` in those files).
NEXT_PUBLIC_SENTRY_DSN=
# Optional, CI/Vercel build only — enables source map upload so stack traces
# show real file/line numbers instead of minified bundle positions. Get these
# from Sentry → Settings → Auth Tokens (scopes: project:releases, org:read).
# Without them, the build just skips the upload with a warning.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ── OPS ALERTING ─────────────────────────────────────────────────
# Where /api/monitoring/stripe-webhook-health emails when Stripe webhook
# deliveries have been failing for 30+ min (Stripe's own auto-disable email
# only fires after ~3 days of continuous failure — this is the faster path).
# Polled every 15 min by .github/workflows/stripe-webhook-health-check.yml,
# authenticated the same way as the other cron routes (INTERNAL_API_KEY).
OPS_ALERT_EMAIL=

# ── DEMO INTEGRATIONS ────────────────────────────────────────────
# Shows a "Demo connector" on /integrations (no real credentials). Enabled by default
# in development; set to "true" to enable in production demos, or "false" to hide.
NEXT_PUBLIC_DEMO_INTEGRATIONS_ENABLED=
